{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MySQL Forge Studio",
  "version": "1.0.0",
  "identifier": "com.mysqlforgestudio.app",
  "build": {
    "beforeDevCommand": "npm --prefix ../../frontend run dev",
    "devUrl": "http://localhost:5173/app",
    "beforeBuildCommand": "npm --prefix ../../frontend run build",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      { "title": "MySQL Forge Studio", "width": 1440, "height": 900, "minWidth": 960, "minHeight": 600, "center": true, "decorations": false }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [],
    "shortDescription": "SQL client, code editor, Git and terminal",
    "windows": {
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false }
    }
  }
}
