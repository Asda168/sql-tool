DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,tauri://localhost,http://tauri.localhost
# PostgreSQL (leave POSTGRES_DB empty to use SQLite in development)
POSTGRES_DB=
POSTGRES_USER=forge
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Redis (leave empty to use in-memory channel layer / local cache in development)
REDIS_URL=
DOWNLOAD_HASH_SALT=change-me-too
